# ── Harness Usage build config ────────────────────────────────────────────────
# Copy this file to `.env` (or run `make env`) and fill in your real values. `.env` is gitignored.
# build.sh sources .env if it exists; these defaults are used when .env is absent
# (dev builds, CI without secrets — everything falls back to ad-hoc/mock safely).

# App version + build number (written into Info.plist by build.sh).
VERSION="0.1.0"
BUILD="1"

# Code signing identity (from Keychain: security find-identity -p codesigning -v)
SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarytool keychain profile (store with: xcrun notarytool store-credentials "harness-usage-notary" ...)
NOTARY_PROFILE="harness-usage-notary"
